{
  // ========================================
  // プレイリスト全体のメタ情報
  // ========================================
  "meta": {
    // 各 lane に volume が指定されていない場合のデフォルト音量
    "default_volume": 100,

    // 各 lane に loop が指定されていない場合のデフォルト
    "default_loop": true,

    // 各 lane に start_offset_sec が指定されていない場合のデフォルト
    "default_start_offset_sec": 0
  },

  // ========================================
  // screen（省略可）
  // 省略時は config/vision_config.json が使われる
  // ========================================
  // "screen": {
  //   "width": 1280,
  //   "height": 256,
  //   "cols": 3,
  //   "rows": 1
  // },

  // ========================================
  // 各レーン定義
  // lane = 1 mpv player process
  // ========================================
  "lanes": {

    // -------------------------
    // Lane 0
    // -------------------------
    "lane0": {

      // この lane 専用の音量（meta.default_volume を上書き）
      "volume": 30,

      // 再生アイテム定義
      "items": [

        // =====================
        // 常に再生可能な動画
        // =====================
        // 文字列だけの表記も許可
        "movie_a.mp4",

        // =====================
        // 解禁日時つき素材
        // =====================
        {
          "path": "poster_30sec_.mp4",

          // この時刻以降に再生可能
          // ISO8601 + timezone 必須
          "is_available_from": "2026-01-27T18:00:00+09:00"
        },

        // =====================
        // 期間限定素材
        // =====================
        {
          "path": "limited_movie.mp4",

          // 開始と終了を両方指定可能
          "is_available_from": "2026-02-01T10:00:00+09:00",
          "is_available_until": "2026-02-10T23:59:59+09:00"
        }
      ]
    },

    // -------------------------
    // Lane 1
    // -------------------------
    "lane1": {

      // volume を省略した場合は meta.default_volume が使われる
      // "volume": 100,

      "items": [

        // =====================
        // シンプルな動画ループ
        // =====================
        {
          "path": "movie_b.mp4"
        },

        // =====================
        // 静止画由来動画（秒数はファイル名由来）
        // =====================
        {
          "path": "notice_15sec_.mp4"
        }
      ]
    },

    // -------------------------
    // Lane 2
    // -------------------------
    "lane2": {

      // この lane を将来無効化する想定がある場合
      // （※ 今はまだ実装しないが、拡張余地として）
      // "enabled": false,

      "items": [

        {
          "path": "background_loop.mp4"
        }
      ]
    }
  },

  // ========================================
  // auto_policy
  // ========================================
  // "auto_policy": {
  //   // encoded/<weekday> 固定
  //   "directory": "encoded/always",
  //
  //   // ソート順（asc / desc）
  //   "sort": "asc",
  //
  //   // auto_policy の合成モード
  //   // - replace_if_empty: items が空の lane だけ自動生成
  //   // - append_remaining: items の末尾に未掲載ファイルを追加
  //   // - disabled: auto_policy を使わない
  //   "mode": "append_remaining"
  // }
}
